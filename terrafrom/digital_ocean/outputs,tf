output "resource_name_prefix" {
  description = "Prefiks wraz z losowym sufiksem używany w nazwach wszystkich zasobów."
  value       = local.name
}

output "project" {
  description = "Utworzony projekt DigitalOcean."
  value = {
    id   = digitalocean_project.this.id
    name = digitalocean_project.this.name
  }
}

output "vpc" {
  description = "VPC i przypisany zakres adresów."
  value = {
    id       = digitalocean_vpc.this.id
    name     = digitalocean_vpc.this.name
    region   = digitalocean_vpc.this.region
    ip_range = digitalocean_vpc.this.ip_range
  }
}

output "droplet" {
  description = "Droplet oraz jego publiczny i prywatny adres IPv4."
  value = {
    id           = digitalocean_droplet.this.id
    name         = digitalocean_droplet.this.name
    public_ipv4  = digitalocean_droplet.this.ipv4_address
    private_ipv4 = digitalocean_droplet.this.ipv4_address_private
  }
}

output "firewall" {
  description = "Firewall przypisany do Dropleta."
  value = {
    id          = digitalocean_firewall.this.id
    name        = digitalocean_firewall.this.name
    droplet_ids = digitalocean_firewall.this.droplet_ids
  }
}

output "ssh_key" {
  description = "Klucz SSH w DigitalOcean i lokalne ścieżki plików; bez treści klucza prywatnego."
  value = {
    id               = digitalocean_ssh_key.this.id
    name             = digitalocean_ssh_key.this.name
    fingerprint      = digitalocean_ssh_key.this.fingerprint
    private_key_file = abspath(local_sensitive_file.ssh_private_key.filename)
    public_key_file  = abspath(local_file.ssh_public_key.filename)
  }
}
